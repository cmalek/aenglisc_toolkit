# Use the .venv next to this file.  direnv evaluates this from its own
# directory and undoes the changes when you leave, so the nested agent project
# (app/core/) switches cleanly to its own .venv.
if [[ -d .venv ]]; then
    export VIRTUAL_ENV="$PWD/.venv"
    PATH_add .venv/bin
else
    log_status "no .venv here yet: run 'make sync'"
fi
